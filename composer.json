{
    "name": "sayamaapps/kirby-emaki",
    "description": "Dependency-free image viewer and gallery helper for Kirby CMS 5.",
    "type": "kirby-plugin",
    "license": "MIT",
    "keywords": [
        "kirby",
        "kirby-plugin",
        "kirby-5",
        "lightbox",
        "gallery",
        "image-viewer",
        "srcset",
        "accessibility",
        "csp"
    ],
    "homepage": "https://github.com/sayamaapps/kirby-emaki",
    "authors": [
        {
            "name": "Simon Räder",
            "homepage": "https://sayamaapps.de"
        }
    ],
    "support": {
        "issues": "https://github.com/sayamaapps/kirby-emaki/issues",
        "source": "https://github.com/sayamaapps/kirby-emaki"
    },
    "require": {
        "php": "^8.2",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cms": "^5.0",
        "phpunit/phpunit": "11.5.55"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "installer-name": "emaki",
        "kirby-cms-path": false,
        "kirby": {
            "compatible": "^5.0"
        }
    }
}
